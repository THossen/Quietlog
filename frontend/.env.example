# Quietlog API base URL for the Expo app.
#
# - iOS simulator: http://127.0.0.1:8000 works.
# - Real device (Expo Go): your PC is NOT 127.0.0.1 to the phone. Put your
#   PC's LAN IP here, e.g. http://192.168.1.20:8000, and run the backend
#   with: uvicorn quietlog.main:app --host 0.0.0.0 --port 8000
# - Android emulator: http://10.0.2.2:8000
#
# Restart `npx expo start` after changing this file (EXPO_PUBLIC_ vars are
# inlined at bundle time). Never commit a real .env (see .gitignore).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
