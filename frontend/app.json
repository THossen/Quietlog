{
  "expo": {
    "name": "Quietlog",
    "slug": "quietlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#15191E",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#15191E"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#15191E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Quietlog uses the microphone only to record your attack notes, on your request."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Quietlog reads your location once when you log, only to record the weather for that moment."
        }
      ]
    ]
  }
}
