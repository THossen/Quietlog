# Copy to .env and fill in. Never commit .env (see .gitignore).
# Meta Model API — verified against Meta docs/cookbook 2026-11 (M2).
# Base URL and model IDs below are the confirmed defaults; the key is yours.
QUIETLOG_MODEL_BASE_URL=https://api.meta.ai/v1
QUIETLOG_SPARK_MODEL=muse-spark-1.3
QUIETLOG_VOICE_MODEL=muse-voice-transcribe-1.0
QUIETLOG_MODEL_API_KEY=
# Model tier: keep "standard". The contributor tier (model IDs ending in
# -contributor, ~$0.10/$0.20 per M tokens) lets Meta train on prompts and
# must not be used with real health information. Quietlog refuses
# contributor models unless explicitly allowed in code.
QUIETLOG_MODEL_TIER=standard
# Optional: reasoning effort override (minimal/low/medium/high/xhigh).
# Unset = API default. Kept minimal for cheap, fast extraction otherwise.
# QUIETLOG_REASONING_EFFORT=minimal
# Local server bind (always loopback) and paths.
QUIETLOG_HOST=127.0.0.1
QUIETLOG_PORT=8000
QUIETLOG_DB=data/quietlog.db
QUIETLOG_AUDIO_DIR=data/audio
QUIETLOG_CACHE_DIR=data/cache
# Optional: weather snapshots (1=on, 0=off) and request timeout in seconds.
# QUIETLOG_WEATHER=1
# QUIETLOG_WEATHER_TIMEOUT=6.0
